# Copy this file to .env.local and fill in your Supabase project's values
# (Supabase dashboard → Settings → API).
#
# The anon key is safe to expose in the browser *as long as* Row Level
# Security policies on your tables are strict — see the README.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Financials imports (/admin/financials) — server-only, never NEXT_PUBLIC_.
# Supabase dashboard → Settings → API Keys → secret key (or the legacy
# service_role key). The PIN is whatever you want people to type to import.
SUPABASE_SECRET_KEY=
FINANCIALS_PIN=
